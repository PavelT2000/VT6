# Пароль root MySQL (используется и приложением, и контейнером db)
DB_PASSWORD=your_mysql_root_password

# Секрет для cookie-сессий (задайте случайную строку на проде)
SECRET_KEY=random-secret-key-here

# Порт приложения на хосте
APP_PORT=8000

# Обычно менять не нужно (в Docker DB_HOST задаётся в compose)
# DB_HOST=db
# DB_USER=root
# DB_NAME=lab6_auth
